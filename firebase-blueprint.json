{
  "entities": {
    "bookings": {
      "title": "Bookings",
      "description": "Consultation and project kickoff bookings",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Client full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Client email"
        },
        "date": {
          "type": "string",
          "description": "Selected date formatted as YYYY-MM-DD"
        },
        "timeSlot": {
          "type": "string",
          "description": "Selected time of day slot (e.g. 11:00 AM)"
        },
        "location": {
          "type": "string",
          "description": "Meeting platform/location (e.g. Google Meet)"
        },
        "phone": {
          "type": "string",
          "description": "Client phone number for text notifications"
        },
        "guests": {
          "type": "string",
          "description": "Guest emails added to the calendar event"
        },
        "currentWebsite": {
          "type": "string",
          "description": "Current website URL if redesign"
        },
        "projectNotes": {
          "type": "string",
          "description": "Details about the project and meeting preparation"
        },
        "foreseenChallenges": {
          "type": "string",
          "description": "Any challenges or bottlenecks the client foresees"
        },
        "estimatedBudget": {
          "type": "string",
          "description": "Estimated budget tier for the web project"
        },
        "additionalInterests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional services interested in (Branding, Strategy, Communication)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when booking was submitted"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "description": "Status of the appointment"
        }
      },
      "required": ["name", "email", "date", "timeSlot", "status"]
    },
    "newsletter_subscribers": {
      "title": "Newsletter Subscribers",
      "description": "Email subscribers registered via the website footer newsletter",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber email address"
        },
        "agreedToTerms": {
          "type": "boolean",
          "description": "Confirmation of terms agreement"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when subscriber signed up"
        },
        "source": {
          "type": "string",
          "description": "Signup source origin (e.g. footer_newsletter)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "unsubscribed"],
          "description": "Subscription status"
        }
      },
      "required": ["email", "agreedToTerms", "subscribedAt", "source", "status"]
    },
    "prompt_waitlist": {
      "title": "Prompt Waitlist",
      "description": "Early access developer waitlist for AI coding prompts",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Developer email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when waitlist was joined"
        },
        "source": {
          "type": "string",
          "description": "Origin of signup"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "bookings",
      "description": "Appointments booked by clients"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "newsletter_subscribers",
      "description": "Newsletter email subscribers"
    },
    "/prompt_waitlist/{waitlistId}": {
      "schema": "prompt_waitlist",
      "description": "Developers who signed up for prompt early access"
    }
  }
}
