rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      // Allow reading booking slots so visitors see real-time availability and blocked slots
      allow read: if true;
      // Allow visitors to create their booking
      allow create: if request.resource.data.name is string &&
                    request.resource.data.email is string &&
                    request.resource.data.date is string &&
                    request.resource.data.timeSlot is string;
      // Restrict update/delete
      allow update, delete: if request.auth != null;
    }

    match /newsletter_subscribers/{subscriberId} {
      // Allow visitors to subscribe to the newsletter
      allow create: if request.resource.data.email is string &&
                    request.resource.data.agreedToTerms == true;
      // Restrict read, update, delete to authenticated admins
      allow read, update, delete: if request.auth != null;
    }
  }
}
